# Local-only secrets -- see SECRETS.local.txt itself for what's covered.
SECRETS.local.txt
*.keystore

# Android build outputs (regenerated by Gradle)
**/build/
**/.gradle/
*.iml
.idea/
local.properties
captures/
.externalNativeBuild/
.cxx/

# Python
__pycache__/
*.pyc
*.log

# Our own compiled APK outputs -- build artifacts, not source. Rebuild via
# each project's README. Vendor's original V3.78.apk IS kept (it's the
# diffing baseline for the SCANNER patch, not something we produced).
SCANNER/V3.78-mts-assign*.apk
SCANNER/V3.78-mts-assign*.apk.idsig
SCANNER/apktool_out/build/
SCANNER/patch_src/out/
SCANNER/patch_src/dexout/
SCANNER/patch_src/smaliout/

# Third-party reverse-engineering tools -- generic, freely redistributable,
# large. Exact versions + download links are in SCANNER/README.md.
SCANNER/tools/*.jar
shortcut.lnk
